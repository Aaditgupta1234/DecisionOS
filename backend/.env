# DecisionOS Environment Configuration
PROJECT_NAME="DecisionOS API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./decisionos.db"

# Security (Future JWT Auth)
SECRET_KEY="development_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# AI Provider Configuration (Phase 9.1 Ollama Integration / Deterministic Mock Default)
AI_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_TIMEOUT=3
OLLAMA_URL="http://localhost:11434"

