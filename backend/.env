# DecisionOS Environment Configuration
PROJECT_NAME="DecisionOS API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (Future PostgreSQL Integration)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/decisionos"

# Security (Future JWT Auth)
SECRET_KEY="development_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# LLM Integration (Future Ollama / Local LLM)
OLLAMA_URL="http://localhost:11434"
